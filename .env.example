# Copy to .env and fill in. Never commit .env.
# provider: ollama (local), gemini (hosted), offline (no model at all)
INBOXHERO_PROVIDER=ollama

# --- local model (development) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- hosted model (final run) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- free-tier pacing ---
INBOXHERO_RPM_DELAY=4.0
INBOXHERO_BATCH=8
INBOXHERO_MAX_RETRIES=4

# --- inbox / owner ---
INBOXHERO_INBOX=data/inbox.json
INBOXHERO_OWNER=sam@paperjet.io
